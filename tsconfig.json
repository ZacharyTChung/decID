{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2023"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "test/unit/**/*.ts",
    "test/types/**/*.d.ts",
    "scripts/**/*.ts",
    "site/**/*.ts",
    "site/**/*.tsx",
    "vitest.config.ts",
    ".next-demo/types/**/*.ts",
    ".next-demo/dev/types/**/*.ts",
    ".next-uitest/types/**/*.ts",
    ".next-uitest/dev/types/**/*.ts",
    ".next-redteam/types/**/*.ts",
    ".next-redteam/dev/types/**/*.ts",
    ".next-bench/types/**/*.ts",
    ".next-bench/dev/types/**/*.ts",
    ".next-multi/types/**/*.ts",
    ".next-multi/dev/types/**/*.ts",
    ".next-product/types/**/*.ts",
    ".next-product/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "test/contracts"
  ]
}
