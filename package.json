{
  "name": "decentralized-identity-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "chain": "hardhat node",
    "compile": "hardhat compile && tsx scripts/gen-abi.ts",
    "setup": "tsx scripts/setup.ts",
    "deploy": "tsx scripts/deploy.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run test:contracts && npm run test:fuzz && npm run test:app",
    "test:contracts": "hardhat test mocha",
    "test:app": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.hardhat.json && tsx scripts/gen-abi.ts --check",
    "demo": "tsx scripts/demo.ts",
    "reset": "tsx scripts/reset.ts",
    "test:ui": "NEXT_DIST_DIR=.next-uitest next build && tsx scripts/ui-test.ts",
    "admin": "tsx scripts/admin.ts",
    "rotate-keys": "tsx scripts/rotate-keys.ts",
    "test:fuzz": "hardhat test solidity",
    "test:coverage": "hardhat test --coverage",
    "verify": "tsx --conditions=react-server scripts/verify.ts",
    "redteam": "tsx scripts/redteam.ts"
  },
  "dependencies": {
    "@digitalbazaar/did-method-key": "5.3.0",
    "@digitalbazaar/ed25519-multikey": "1.3.1",
    "better-sqlite3": "13.0.3",
    "ethers": "6.17.0",
    "jose": "6.2.13",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "siwe": "3.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@nomicfoundation/hardhat-ethers": "4.2.1",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "3.0.13",
    "@nomicfoundation/hardhat-mocha": "4.0.1",
    "@nomicfoundation/hardhat-network-helpers": "3.0.12",
    "@openzeppelin/contracts": "5.6.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/chai": "5.2.3",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "chai": "6.3.0",
    "forge-std": "github:foundry-rs/forge-std#v1.17.0",
    "hardhat": "3.20.0",
    "mocha": "12.0.3",
    "playwright": "1.56.1",
    "solc": "0.8.37",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
