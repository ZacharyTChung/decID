# Copy is NOT needed: `npm run setup` generates .env.local with fresh local keys.
# This file documents the variables with placeholder values only.

# Exact origin the browser uses (checked against Origin headers, SIWE domain, presentation audience).
APP_ORIGIN=http://localhost:3000
# Local Hardhat JSON-RPC endpoint. No external RPC provider is needed.
RPC_URL=http://127.0.0.1:8545

# SERVER-ONLY issuer secrets (never prefix with NEXT_PUBLIC_).
# Ed25519 private JWK for the issuer's did:key credential signing key.
ISSUER_CREDENTIAL_PRIVATE_JWK={"kty":"OKP","crv":"Ed25519","x":"<public>","d":"<private>"}
# secp256k1 key authorized in CredentialRegistry to sign EIP-712 registration authorizations.
ISSUER_EVM_PRIVATE_KEY=0x<64 hex chars>

# Comma-separated wallet addresses allowed to sign in as issuer operator.
# Default: Hardhat public dev account #1.
ISSUER_OPERATOR_ADDRESSES=0x70997970C51812dc3A010C7d01b50e0d17dc79C8

# Optional
# CREDENTIAL_LIFETIME_DAYS=365
# DATA_DIR=.data
# DEPLOYMENT_FILE=deployments/localhost.json
# TRUSTED_ISSUERS_FILE=config/trusted-issuers.local.json
